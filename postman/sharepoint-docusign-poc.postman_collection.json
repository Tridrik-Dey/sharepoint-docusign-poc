{
  "info": {
    "name": "sharepoint-docusign-poc",
    "description": "PO -> SharePoint documents -> DocuSign envelope technical POC. Import this collection and set the `baseUrl` variable (default http://localhost:8080).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "https://sharepoint-docusign-poc-119848802932.europe-west1.run.app", "type": "string" },
    { "key": "apiKey", "value": "480694573e740a5d7a580bc71e1818f68769657f3d333f45421fe4332b86e236", "type": "string" }
  ],
  "item": [
    {
      "name": "Get PO Documents - retrieve only, no DocuSign",
      "request": {
        "method": "GET",
        "header": [
          { "key": "X-Api-Key", "value": "{{apiKey}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/po-documents/4500000105/02",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "po-documents", "4500000105", "02"]
        },
        "description": "Retrieves the SharePoint documents for this PO/revision as base64-encoded content. No DocuSign or envelope logic involved - for callers that want to handle the documents themselves (e.g. attach to their own system)."
      },
      "response": []
    },
    {
      "name": "Get PO Documents - flat folder (no revision subfolder)",
      "request": {
        "method": "GET",
        "header": [
          { "key": "X-Api-Key", "value": "{{apiKey}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/po-documents/4500000233",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "po-documents", "4500000233"]
        },
        "description": "Flat folder layout: the PO number folder itself contains the documents directly, with no REV-xx revision subfolder. Only pass the poNumber path segment - no revision. The response omits 'revision' entirely."
      },
      "response": []
    },
    {
      "name": "Create PO Envelope - success (mock mode sample)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "X-Api-Key", "value": "{{apiKey}}" }
        ],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "metadata",
              "value": "{\n  \"poNumber\": \"4500000105\",\n  \"revision\": \"02\",\n  \"vendorName\": \"Dummy Vendor SRL\",\n  \"vendorEmail\": \"test@example.com\"\n}",
              "contentType": "application/json",
              "type": "text"
            },
            {
              "key": "purchaseOrderDocument",
              "type": "file",
              "src": "sample-files/Purchase-Order-4500000105.pdf"
            }
          ]
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/po-envelopes",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "po-envelopes"]
        },
        "description": "Expects mock mode (SPRING_PROFILES_ACTIVE=mock) and the bundled sample PDFs. Returns success=true with a mock-envelope-* id."
      },
      "response": []
    },
    {
      "name": "Create PO Envelope - unknown PO (SHAREPOINT_FOLDER_NOT_FOUND)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "X-Api-Key", "value": "{{apiKey}}" }
        ],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "metadata",
              "value": "{\n  \"poNumber\": \"0000000000\",\n  \"revision\": \"01\",\n  \"vendorName\": \"Dummy Vendor SRL\",\n  \"vendorEmail\": \"test@example.com\"\n}",
              "contentType": "application/json",
              "type": "text"
            },
            {
              "key": "purchaseOrderDocument",
              "type": "file",
              "src": "sample-files/Purchase-Order-4500000105.pdf"
            }
          ]
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/po-envelopes",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "po-envelopes"]
        },
        "description": "No SharePoint folder exists for this PO/revision - expect HTTP 404 with errorCode=SHAREPOINT_FOLDER_NOT_FOUND."
      },
      "response": []
    },
    {
      "name": "Create PO Envelope - invalid PO number format (INVALID_REQUEST)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "X-Api-Key", "value": "{{apiKey}}" }
        ],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "metadata",
              "value": "{\n  \"poNumber\": \"invalid/po\",\n  \"revision\": \"02\",\n  \"vendorName\": \"Dummy Vendor SRL\",\n  \"vendorEmail\": \"test@example.com\"\n}",
              "contentType": "application/json",
              "type": "text"
            },
            {
              "key": "purchaseOrderDocument",
              "type": "file",
              "src": "sample-files/Purchase-Order-4500000105.pdf"
            }
          ]
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/po-envelopes",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "po-envelopes"]
        },
        "description": "poNumber contains a '/' - expect HTTP 400 with errorCode=INVALID_REQUEST."
      },
      "response": []
    },
    {
      "name": "Create PO Envelope - non-PDF main document (INVALID_PDF)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "X-Api-Key", "value": "{{apiKey}}" }
        ],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "metadata",
              "value": "{\n  \"poNumber\": \"4500000105\",\n  \"revision\": \"02\",\n  \"vendorName\": \"Dummy Vendor SRL\",\n  \"vendorEmail\": \"test@example.com\"\n}",
              "contentType": "application/json",
              "type": "text"
            },
            {
              "key": "purchaseOrderDocument",
              "type": "file",
              "src": "README.md"
            }
          ]
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/po-envelopes",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "po-envelopes"]
        },
        "description": "Uploads a non-PDF file - expect HTTP 400 with errorCode=INVALID_PDF."
      },
      "response": []
    }
  ]
}
