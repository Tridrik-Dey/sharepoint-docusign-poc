# Copy to .env and fill in real values, or export these as environment
# variables before running with the "local" profile. Never commit a real
# .env file - it is already excluded via .gitignore.

# ---- Spring profile ----
# "mock"  -> no external credentials needed, uses local mock services
# "local" -> calls real Microsoft Graph and DocuSign
SPRING_PROFILES_ACTIVE=mock

# ---- Microsoft Entra / Graph (required only for the "local" profile) ----
MICROSOFT_TENANT_ID=00000000-0000-0000-0000-000000000000
MICROSOFT_CLIENT_ID=00000000-0000-0000-0000-000000000000
MICROSOFT_CLIENT_SECRET=changeme
SHAREPOINT_HOSTNAME=company.sharepoint.com
SHAREPOINT_SITE_PATH=/sites/DocuSAP-POC
# The "PO-Documents" document library's drive id - see README section 9 for
# how to look this up (Graph Explorer or curl against /sites/{site-id}/drives).
SHAREPOINT_DRIVE_ID=b!changeme

# ---- Microsoft Graph timeouts (optional - defaults are in application.yml) ----
# MICROSOFT_GRAPH_CONNECT_TIMEOUT_MS=5000
# MICROSOFT_GRAPH_READ_TIMEOUT_MS=10000
# MICROSOFT_GRAPH_RESPONSE_TIMEOUT_MS=15000

# ---- DocuSign (required only for the "local" profile) ----
DOCUSIGN_INTEGRATION_KEY=00000000-0000-0000-0000-000000000000
DOCUSIGN_USER_ID=00000000-0000-0000-0000-000000000000
DOCUSIGN_ACCOUNT_ID=00000000-0000-0000-0000-000000000000
DOCUSIGN_PRIVATE_KEY_PATH=/absolute/path/to/docusign_private_key.pem
DOCUSIGN_BASE_PATH=https://demo.docusign.net/restapi
DOCUSIGN_OAUTH_BASE_PATH=account-d.docusign.com

# ---- Application behaviour ----
# false = create envelope as a draft (status=created) instead of sending it
DOCUSIGN_SEND_ENVELOPE=true

# ---- API protection (optional locally, REQUIRED once deployed anywhere
# reachable beyond localhost - e.g. Railway, for SAP to call) ----
# When set, every /api/** request must include a matching X-Api-Key header.
# Leave blank for local testing.
# API_KEY=changeme-use-a-long-random-value
